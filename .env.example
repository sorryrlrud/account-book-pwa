# Public OAuth client identifier. Never add a client secret.
VITE_GOOGLE_CLIENT_ID=

# Bootstrap spreadsheet used to discover the connected year graph.
VITE_BOOTSTRAP_SPREADSHEET_ID=

# Explicit TEST root required for all write operations during development.
# Writes remain disabled when this is empty or does not match the bootstrap root.
VITE_TEST_SPREADSHEET_ID=

# Set by the GitHub Pages workflow. Local development uses /.
VITE_BASE_PATH=/
